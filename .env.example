# ----- Server -----
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1

# ----- Database (PostgreSQL) -----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://chronos:chronos@localhost:5432/chronos?schema=public

# ----- Redis -----
# Option A: paste a single URL (e.g. from Upstash / Render / Railway)
#   redis://default:<password>@<host>:<port>      (plain)
#   rediss://default:<password>@<host>:<port>     (TLS — most cloud providers)
# REDIS_URL=

# Option B: leave REDIS_URL blank and use host/port (e.g. local install)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ----- JWT -----
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ----- Worker / Queue -----
JOB_QUEUE_NAME=chronos-jobs
WORKER_CONCURRENCY=5
DEFAULT_MAX_RETRIES=3
DEFAULT_RETRY_BACKOFF_MS=5000

# ----- Logging -----
LOG_LEVEL=info

# ----- Bull Board (admin UI) -----
BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/admin/queues

# ----- Optional: SMTP for email job handler (leave blank to log instead of send) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chronos <noreply@chronos.local>"
