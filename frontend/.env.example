# Base URL for the Chronos backend.
# - In dev, leave it as `/api/v1` so the Vite proxy forwards to the backend.
# - In production, set it to the absolute URL of your backend.
VITE_API_BASE_URL=/api/v1

# Used by the Vite dev server proxy. Defaults to http://localhost:4000.
VITE_API_PROXY_TARGET=http://localhost:4000
